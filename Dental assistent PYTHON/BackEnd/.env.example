# ---------------------------------------------------------------------------
# Dental Assistant Backend — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# API key required on every request (X-API-Key header).
# Change this to a strong random value in production.
APP_API_KEY=dental-assistant-local-dev-key

# Runtime environment. Set to "production" to enforce a non-default API key
# and enable stricter security checks.
ENV=development

# Optional: override the directory where models, the RAG journal, and the
# audit log are stored. Defaults to a platform-specific location:
#   Windows : %LOCALAPPDATA%\DentalAssistant
#   macOS   : ~/Library/Application Support/DentalAssistant
#   Linux   : ~/.local/share/DentalAssistant
# DENTAL_ASSISTANT_DATA_DIR=/path/to/custom/data/dir
